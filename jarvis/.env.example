# Copie ce fichier en .env puis remplis-le.  (cp .env.example .env)

# Clé API Anthropic pour le renfort Claude (https://console.anthropic.com)
# Sans clé, Jarvis fonctionne quand même, en local uniquement.
ANTHROPIC_API_KEY=

# Modèle local Ollama (voir le README pour choisir selon la RAM du Mac)
JARVIS_MODELE_LOCAL=mistral-small3.2

# Modèle Claude pour les questions difficiles
JARVIS_MODELE_CLAUDE=claude-opus-5-5
JARVIS_EFFORT_CLAUDE=medium

JARVIS_PRENOM=Enes
JARVIS_FUSEAU=Europe/Paris
