# Copie ce fichier en .env puis remplis-le.  (cp .env.example .env)

# --- Renfort Claude pour les questions difficiles ---
#   abonnement : passe par Claude Code connecté à ton compte Claude (pas de coût en plus)
#   api        : passe par une clé API Anthropic (payé à l'usage)
#   gemini     : passe par Gemini (clé API Google, payé à l'usage)
#   gemini-abonnement : passe par Gemini CLI, connecté à ton compte Google (pas de coût en plus)
#   aucun      : 100 % local
# Astuce : laisse JARVIS_RENFORT=abonnement ET remplis GEMINI_API_KEY ci-dessous :
# Jarvis utilise alors Claude ET Gemini (Gemini devient un « deuxième avis »).
JARVIS_RENFORT=abonnement

# Mode "abonnement" : modèle Claude Code (vide = celui par défaut de ton compte, ex. opus, sonnet)
JARVIS_MODELE_ABONNEMENT=

# Mode mentor : Claude exécute les tâches importantes (code, scripts) en agent sur le PC,
# uniquement dans l'atelier ~/.jarvis/atelier et après ta confirmation. 1 = activé.
# Nécessite Claude Code. Puissant : à n'activer que si tu comprends ce que ça permet.
JARVIS_MENTOR=0
# Amélioration de nuit (avec JARVIS_MENTOR=1) : à cette heure, le mentor code l'idée la plus
# demandée de son journal ; le matin, Jarvis te l'annonce (boutons ✅/❌ sur Telegram). Vide = off.
JARVIS_AMELIORATION_NUIT=03:00
# Extensions (plugins/) chargées et rechargées à chaud, sans redémarrer Jarvis. 0 = au démarrage seulement.
JARVIS_RECHARGEMENT_A_CHAUD=1
JARVIS_RECHARGEMENT_SECONDES=2

# Mode "api" uniquement : clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=
JARVIS_MODELE_CLAUDE=claude-opus-5-5
JARVIS_EFFORT_CLAUDE=medium

# Mode "gemini" : clé sur https://aistudio.google.com
GEMINI_API_KEY=
JARVIS_MODELE_GEMINI=gemini-2.5-flash

# Abonnement Gemini (Gemini CLI, compte Google). 1 = l'ajouter comme deuxième avis à côté de Claude.
# Nécessite : npm install -g @google/gemini-cli, puis « gemini » une fois pour se connecter.
JARVIS_GEMINI_ABONNEMENT=0

# Repli automatique : si le renfort principal ne peut pas coder une amélioration
# (quota épuisé, non connecté, panne), l'autre prend le relais — dans les deux sens.
# Exemple : mets JARVIS_RENFORT=gemini-abonnement pour que GEMINI code en premier et
# CLAUDE prenne le relais. Gemini ne pilote pas la machine : il propose le code, Jarvis
# l'écrit dans l'atelier, puis sandbox + tes tests + ton ✅ (rien n'est appliqué sans toi).
#   auto (défaut) : l'autre famille que le principal, si installée
#   gemini-cli | gemini : forcer un repli Gemini   |   claude | claude-api : forcer un repli Claude
#   aucun : pas de repli
JARVIS_RENFORT_REPLI=auto

# --- Confidentialité ---
# 1 = rien ne sort de l'ordinateur (renfort Claude coupé, Hugging Face bloqué).
# À activer seulement une fois l'installation terminée (Whisper doit être téléchargé).
JARVIS_HORS_LIGNE=0

# --- Bot Telegram (python telegram_bot.py) ---
# Jeton donné par @BotFather sur Telegram. Ne le partage jamais.
TELEGRAM_TOKEN=
# Ton identifiant Telegram : le bot ne répond qu'à lui.
# Laisse vide au début : envoie /start au bot, il te donnera le numéro à mettre ici.
JARVIS_TELEGRAM_ID=

# --- Signal (alertes chiffrées, via signal-cli) ---
# Alternative à Telegram, plus respectueuse de la vie privée. Voir signal_notify.py
# pour relier Jarvis à ton téléphone (signal-cli link). Vide = Signal désactivé.
# Chemin de signal-cli (laisse "signal-cli" s'il est dans le PATH).
JARVIS_SIGNAL_CLI=signal-cli
# Numéro qui envoie (le compte signal-cli), au format international, ex. +33600000000.
JARVIS_SIGNAL_EXPEDITEUR=
# Numéro qui reçoit les alertes (le tien). Mets le même que l'expéditeur pour
# recevoir dans ta conversation « Notes » (toi à toi-même).
JARVIS_SIGNAL_DESTINATAIRE=

# --- Maison connectée (Home Assistant, en local sur ton réseau) ---
# Adresse de Home Assistant (ex. http://homeassistant.local:8123) et jeton d'accès
# longue durée (Home Assistant → ton profil → Jetons d'accès). Vide = pas de domotique.
HOMEASSISTANT_URL=
HOMEASSISTANT_TOKEN=
# Aspirateur robot dé-cloudé (Valetudo, exposé dans Home Assistant). Associe tes pièces à
# leur « segment » Valetudo (vois les numéros dans l'interface Valetudo). Vide = ménage complet seul.
# JARVIS_ASPIRATEUR_PIECES={"salon":"16","cuisine":"17","chambre":"18"}

# --- Drone (Parrot ANAFI) ---
# 0 = pas de drone ; sim = simulateur maison ; anafi = Parrot ANAFI ; mavlink = drone DIY (ArduPilot/PX4)
JARVIS_DRONE=0
JARVIS_DRONE_IP=192.168.42.1
# Drone DIY : adresse MAVLink. udp:127.0.0.1:14550 = simulateur ArduPilot SITL.
JARVIS_DRONE_URL=udp:127.0.0.1:14550
# Limites de vol. Sous la limite NORMALE (légale), le drone vole librement. Au-dessus
# (mais sous le PLAFOND absolu), Jarvis demande « vous êtes sûr ? » avant. Reste légal.
JARVIS_DRONE_ALT_MAX=120        # limite normale (légale), altitude en mètres
JARVIS_DRONE_ALT_PLAFOND=500    # plafond absolu, atteignable seulement en confirmant
JARVIS_DRONE_DIST_MAX=120       # limite normale, éloignement en mètres
JARVIS_DRONE_DIST_PLAFOND=2000  # plafond absolu d'éloignement (augmenté)
JARVIS_DRONE_PAS_MAX=20         # déplacement max par commande

# --- Vision (décrire une image : vue du drone, etc.) ---
# auto = local si dispo sinon Gemini ; local = modèle sur ce PC ; gemini ; 0 = coupée
JARVIS_VISION=auto
# Modèle de vision LOCAL via Ollama (privé, hors ligne). Ex. : ollama pull qwen2.5-vl
JARVIS_MODELE_VISION=

# --- Tableau de bord sur la télé (python dashboard.py) ---
# 127.0.0.1 = seulement sur ce PC (branché en HDMI). 0.0.0.0 = visible depuis le réseau (tablette).
JARVIS_ECRAN_HOTE=127.0.0.1
JARVIS_ECRAN_PORT=8765
# Jeton d'accès. VIVEMENT conseillé si JARVIS_ECRAN_HOTE=0.0.0.0, sinon tes rappels/listes/
# état maison sont lisibles par tout le monde sur le Wi-Fi. Ouvre alors la page avec /?jeton=...
JARVIS_ECRAN_JETON=

# --- Cerveau local (choisis selon ta machine) ---
# qwen3:30b-a3b (défaut) : MoE, malin ET rapide, idéal mini PC sans GPU.
# qwen3:32b : plus fin mais plus lent (écrit). mistral-small3.2 : léger et rapide.
# Le code difficile part de toute façon au renfort Claude/Gemini.
JARVIS_MODELE_LOCAL=qwen3:30b-a3b
# Qwen3 « réfléchit » avant de répondre : 0 = répond directement (plus rapide, conseillé à l'oral),
# 1 = réfléchit (meilleur pour les questions dures), vide = défaut du modèle.
JARVIS_REFLEXION_LOCALE=0
# Réglages fins trouvés par le banc d'essai (python bench.py --appliquer). Vide = automatique.
JARVIS_OPTIONS_OLLAMA=

# --- Initiatives : Jarvis parle en premier ---
# Heure du briefing du matin (météo, rappels du jour, courses, état du PC). Vide = pas de briefing.
JARVIS_BRIEFING=08:00
# Alertes sur le PC (disque presque plein, antivirus coupé, redémarrage conseillé). 0 = aucune.
JARVIS_ALERTES=1
# Sentinelle : surveille les signes d'intrusion et alerte (lecture seule). 0 = coupée.
JARVIS_SENTINELLE=1
# Cybersurveillance continue : en boucle, la machine (ports, réseau, pare-feu) ET le code
# de Jarvis lui-même (tripwire d'intégrité du cœur). Alerte si un fichier du cœur change
# hors du circuit validé. 0 = coupée. Intervalle en secondes.
JARVIS_CYBERSURVEILLANCE=1
JARVIS_CYBERSURVEILLANCE_SECONDES=300
# Réaction automatique : si un fichier du cœur est trafiqué, Jarvis le RESTAURE tout seul
# (sûr et réversible : il remet une version saine, il ne génère JAMAIS de code tout seul).
# 1 = activé. Si tu modifies le cœur hors du bot, fais « sauvegarde cœur » après.
JARVIS_AUTO_RESTAURATION=0
# Pot de miel (honeypot) : un faux serveur leurre. Toute connexion est suspecte -> Jarvis
# note l'IP et t'alerte. N'a aucun accès au cœur. 0 = coupé. Port > 1024.
JARVIS_HONEYPOT=0
JARVIS_HONEYPOT_PORT=2222
# Blocage d'IP défensif (commande « bloque <ip> » après une alerte). IP publiques à ne
# JAMAIS bloquer (ex. ton DNS), séparées par des virgules. Les IP privées sont déjà protégées.
JARVIS_IP_LISTE_BLANCHE=
# Heures de silence : ni briefing ni alerte (les rappels et les alertes de sécurité critiques passent toujours).
JARVIS_SILENCE=22:00-07:00

# --- Personnalité ---
# film = majordome flegmatique qui vous vouvoie ; ami = ton chaleureux, tutoiement
JARVIS_STYLE=film
# Comment Jarvis s'adresse à toi en style film (Monsieur, Madame, Patron...). Vide = ton prénom.
JARVIS_TITRE=
# Voix : fr_FR-tom-medium.onnx (homme, défaut) ou fr_FR-siwis-medium.onnx (femme), chemin complet.
# Pour une voix encore plus nette, pointe vers un modèle « -high » (un peu plus lourd mais toujours rapide).
# JARVIS_VOIX_PIPER=
# Prosodie : rend la voix plus humaine, sans alourdir (reste instantané, local).
JARVIS_VOIX_VITESSE=1.06        # > 1 = plus posé, majordome ; 1.0 = normal
JARVIS_VOIX_PAUSES=0.35         # silence entre phrases (respiration), en secondes
JARVIS_VOIX_EXPRESSIVITE=0.7    # variation d'intonation : 0.3 = sobre, 1.0 = ample
# Mode mains libres : secondes d'écoute après une réponse, sans redire « Jarvis »
JARVIS_ECOUTE_SECONDES=30

# Reconnaissance de visages (locale). 1 = activée (nécessite face-recognition + pillow).
JARVIS_VISAGES=0

JARVIS_PRENOM=Enes
JARVIS_FUSEAU=Europe/Paris
# Ville par défaut pour la météo (seul le nom de la ville est envoyé à open-meteo.com)
JARVIS_VILLE=

# --- Annonces d'arrivée (caméras Frigate / Double Take, via MQTT) ---
# Jarvis annonce « Monsieur, Carlos est à la porte » et alerte sur un inconnu.
# Nécessite un broker MQTT (Mosquitto) et Frigate+Double Take. 0 = coupé.
# Installe : pip install paho-mqtt
JARVIS_MQTT=0
JARVIS_MQTT_HOTE=localhost
JARVIS_MQTT_PORT=1883
JARVIS_MQTT_SUJET=double-take/matches/#
JARVIS_MQTT_USER=
JARVIS_MQTT_PASS=
# Auto-regard : sur détection, Jarvis oriente une caméra motorisée vers la zone et décrit
# ce qu'il voit (nécessite des « presets » par zone dans ptz.json). 1 = activé, 0 = coupé.
JARVIS_AUTO_REGARD=1

# --- Mode Sentinelle (réaction active anti-intrusion) ---
# Tu l'armes (« Jarvis, arme la surveillance ») ; sur visage INCONNU, Jarvis allume les
# lumières, (option) verrouille, enregistre, diffuse une sommation et t'alerte.
# Jarvis n'appelle JAMAIS la police seul : il t'alerte, tu décides.
JARVIS_SURV_LUMIERES=          # entity_id des lumières extérieures, séparés par des virgules
JARVIS_SURV_SERRURES=          # entity_id des serrures
JARVIS_SURV_VERROUILLER=0      # 1 = verrouiller les portes sur intrusion
JARVIS_SURV_HAUTPARLEUR=       # media_player extérieur pour la sommation
JARVIS_SURV_MESSAGE=           # vide = « zone sous surveillance, vous êtes enregistré »
JARVIS_SURV_TTS=tts.google_translate_say
JARVIS_SURV_ENR_SERVICE=       # service HA pour lancer un enregistrement (ex. switch.turn_on)
JARVIS_SURV_ENR_ENTITE=

# --- Point de situation (lecture seule) ---
# Capteurs que Jarvis surveille pour avoir conscience du moment (détections caméra, état du
# drone, batteries...). « Jarvis, fais le point. » entity_id séparés par des virgules.
JARVIS_TELEMETRIE=

# --- Arroseur anti-nuisibles (dissuasion par zone, pas de ciblage) ---
# Associe une zone du jardin à l'interrupteur de son arroseur. « Jarvis, arrose le parterre. »
# Pour un déclenchement auto sur détection d'animal, crée une automatisation HA (capteur -> arroseur).
# JARVIS_ARROSEUR={"parterre":"switch.arroseur_parterre","potager":"switch.arroseur_potager"}

# --- Ouïe analytique (classification des sons, YAMNet) ---
# Un micro + YAMNet : Jarvis entend bris de glace, alarme incendie, pleurs, cri...
# et t'alerte (+ reaction Sentinelle si armee). Lourd a installer : pip install tensorflow tensorflow-hub
JARVIS_OREILLE=0
JARVIS_OREILLE_SEUIL=0.5

# --- Detection d'objets personnalisee (Ultralytics YOLO) ---
# Entraine YOLO sur tes objets (colis, porte de garage ouverte, outil manquant...) et donne
# ici le chemin du modele .pt. « Y a-t-il un colis a l'entree ? ». Vide = desactive.
# pip install ultralytics
JARVIS_YOLO_MODELE=
JARVIS_YOLO_SEUIL=0.4
