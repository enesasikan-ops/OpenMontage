# Copie ce fichier en .env puis remplis-le.  (cp .env.example .env)

# --- Renfort Claude pour les questions difficiles ---
#   abonnement : passe par Claude Code connecté à ton compte Claude (pas de coût en plus)
#   api        : passe par une clé API Anthropic (payé à l'usage)
#   gemini     : passe par Gemini (clé API Google, payé à l'usage)
#   gemini-abonnement : passe par Gemini CLI, connecté à ton compte Google (pas de coût en plus)
#   aucun      : 100 % local
# Astuce : laisse JARVIS_RENFORT=abonnement ET remplis GEMINI_API_KEY ci-dessous :
# Jarvis utilise alors Claude ET Gemini (Gemini devient un « deuxième avis »).
JARVIS_RENFORT=abonnement
# Vie privée : avant d'envoyer au cloud (Claude/Gemini), Jarvis retire ton prénom et ta
# ville et les remplace par des termes neutres. 1 = activé (défaut), 0 = le cloud voit ton
# vrai prénom (si tu veux qu'il t'appelle par ton nom).
JARVIS_RENFORT_ANONYME=1

# Mode "abonnement" : modèle Claude Code (vide = celui par défaut de ton compte, ex. opus, sonnet)
JARVIS_MODELE_ABONNEMENT=

# Mode mentor : Claude exécute les tâches importantes (code, scripts) en agent sur le PC,
# uniquement dans l'atelier ~/.jarvis/atelier et après ta confirmation. 1 = activé.
# Nécessite Claude Code. Puissant : à n'activer que si tu comprends ce que ça permet.
JARVIS_MENTOR=0
# Amélioration de nuit (avec JARVIS_MENTOR=1) : à cette heure, le mentor code l'idée la plus
# demandée de son journal ; le matin, Jarvis te l'annonce (boutons ✅/❌ sur Telegram). Vide = off.
JARVIS_AMELIORATION_NUIT=03:00
# Extensions (plugins/) chargées et rechargées à chaud, sans redémarrer Jarvis. 0 = au démarrage seulement.
JARVIS_RECHARGEMENT_A_CHAUD=1
JARVIS_RECHARGEMENT_SECONDES=2

# Mode "api" uniquement : clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=
JARVIS_MODELE_CLAUDE=claude-opus-5-5
JARVIS_EFFORT_CLAUDE=medium

# Mode "gemini" : clé sur https://aistudio.google.com
GEMINI_API_KEY=
JARVIS_MODELE_GEMINI=gemini-2.5-flash

# Abonnement Gemini (Gemini CLI, compte Google). 1 = l'ajouter comme deuxième avis à côté de Claude.
# Nécessite : npm install -g @google/gemini-cli, puis « gemini » une fois pour se connecter.
JARVIS_GEMINI_ABONNEMENT=0

# Repli automatique : si le renfort principal ne peut pas coder une amélioration
# (quota épuisé, non connecté, panne), l'autre prend le relais — dans les deux sens.
# Exemple : mets JARVIS_RENFORT=gemini-abonnement pour que GEMINI code en premier et
# CLAUDE prenne le relais. Gemini ne pilote pas la machine : il propose le code, Jarvis
# l'écrit dans l'atelier, puis sandbox + tes tests + ton ✅ (rien n'est appliqué sans toi).
#   auto (défaut) : l'autre famille que le principal, si installée
#   gemini-cli | gemini : forcer un repli Gemini   |   claude | claude-api : forcer un repli Claude
#   aucun : pas de repli
JARVIS_RENFORT_REPLI=auto

# --- Confidentialité ---
# 1 = rien ne sort de l'ordinateur (renfort Claude coupé, Hugging Face bloqué).
# À activer seulement une fois l'installation terminée (Whisper doit être téléchargé).
JARVIS_HORS_LIGNE=0

# --- Bot Telegram (python telegram_bot.py) ---
# Jeton donné par @BotFather sur Telegram. Ne le partage jamais.
TELEGRAM_TOKEN=
# Ton identifiant Telegram : le bot ne répond qu'à lui.
# Laisse vide au début : envoie /start au bot, il te donnera le numéro à mettre ici.
JARVIS_TELEGRAM_ID=

# --- Signal (alertes chiffrées, via signal-cli) ---
# Alternative à Telegram, plus respectueuse de la vie privée. Voir signal_notify.py
# pour relier Jarvis à ton téléphone (signal-cli link). Vide = Signal désactivé.
# Chemin de signal-cli (laisse "signal-cli" s'il est dans le PATH).
JARVIS_SIGNAL_CLI=signal-cli
# Numéro qui envoie (le compte signal-cli), au format international, ex. +33600000000.
JARVIS_SIGNAL_EXPEDITEUR=
# Numéro qui reçoit les alertes (le tien). Mets le même que l'expéditeur pour
# recevoir dans ta conversation « Notes » (toi à toi-même).
JARVIS_SIGNAL_DESTINATAIRE=

# --- Maison connectée (Home Assistant, en local sur ton réseau) ---
# Adresse de Home Assistant (ex. http://homeassistant.local:8123) et jeton d'accès
# longue durée (Home Assistant → ton profil → Jetons d'accès). Vide = pas de domotique.
HOMEASSISTANT_URL=
HOMEASSISTANT_TOKEN=
# Aspirateur(s) robot exposé(s) dans Home Assistant. Associe tes pièces à leur « segment ».
# Vide = ménage complet seul. Plusieurs robots : commandes sur tous, ou cible par nom à la voix.
# JARVIS_ASPIRATEUR_PIECES={"salon":"16","cuisine":"17","chambre":"18"}
# Firmware : "valetudo" (dé-cloudé, local) ou "roborock" (app officielle Roborock, ex. Saros Z70).
# Change la commande de nettoyage par pièce. Les numéros de segment : app Roborock ou Valetudo.
JARVIS_ASPIRATEUR_BACKEND=valetudo

# --- Veille aérienne : détection de drones par Remote ID / OpenDroneID ---
# Un récepteur dédié (OpenDroneID Bluetooth/Wi-Fi, ou décodeur SDR) publie les détections
# sur MQTT ; Jarvis alerte qu'un drone survole et CONSIGNE la détection comme preuve (pour
# un dépôt de plainte). Détecter/recevoir est légal ; Jarvis ne traque pas le pilote, il
# enregistre. Ne voit que les drones conformes (qui émettent un Remote ID). 1 = activé.
JARVIS_AERIEN=0
JARVIS_AERIEN_SUJET=opendroneid/#        # topic MQTT du récepteur
JARVIS_AERIEN_COOLDOWN=120               # délai (s) avant de ré-alerter sur le même drone

# --- Réflexion proactive : Jarvis fait le point de lui-même, s'il a à dire ---
# À intervalle régulier, il relie ses capteurs et n'alerte QUE si quelque chose mérite ton
# attention (sinon silence). Respecte les heures de silence (ne parle pas la nuit). Chaque
# tour envoie un instantané au renfort (cloud) : garde un intervalle large. 1 = activé.
JARVIS_CONSCIENCE_PROACTIVE=0
JARVIS_CONSCIENCE_SECONDES=1800          # intervalle entre deux points de situation (défaut 30 min)

# --- Ouïe TinyML au bord (ESP32 + Edge Impulse) : l'événement arrive, pas l'audio ---
# Un ESP32 détecte les bruits d'effraction SUR LA PUCE (verre brisé, coup dans une porte,
# aboiement de détresse) et publie seulement l'ÉVÉNEMENT sur MQTT — l'audio ne sort jamais.
# Jarvis alerte et déclenche la Sentinelle si armée. Le son traverse les angles morts des
# caméras. 1 = activé.
JARVIS_OREILLE_MQTT=0
JARVIS_OREILLE_SUJET=jarvis/oreille/#    # topic MQTT où l'ESP32 publie ses détections
JARVIS_OREILLE_SEUIL=0.5                 # score minimal pour retenir une détection

# --- Voiture connectée : via l'API constructeur exposée dans Home Assistant ---
# Position, serrures, carburant/charge — PAS de bus CAN, PAS d'OpenPilot (aucun lien IA ↔
# commandes du véhicule). Intégration HA du constructeur (Tesla, Hyundai/Kia, Toyota…).
# Déverrouiller à distance = confirmé. 1 = activé.
JARVIS_VOITURE=0
JARVIS_VOITURE_POSITION=                 # entité device_tracker.xxx (position GPS)
JARVIS_VOITURE_SERRURE=                  # entité lock.xxx (serrures)
JARVIS_VOITURE_CAPTEURS=                 # JSON : {"carburant":"sensor.voiture_carburant","autonomie":"sensor.voiture_range"}

# --- Canal de commandement Matrix : alertes sur TON serveur chiffré (au lieu de tiers) ---
# Jarvis poste ses alertes (texte + clips Frigate) sur ton serveur Matrix (Synapse), salon
# chiffré de bout en bout — métadonnées chez toi. Nécessite : pip install "matrix-nio[e2e]".
# Le jeton d'accès du compte Jarvis est un SECRET. 1 = activé (en plus de Telegram/Signal).
JARVIS_MATRIX=0
JARVIS_MATRIX_SERVEUR=                    # https://matrix.ton-domaine.fr
JARVIS_MATRIX_JETON=                      # jeton d'accès du compte Jarvis (secret)
JARVIS_MATRIX_SALON=                      # !idDuSalon:ton-domaine.fr
JARVIS_MATRIX_USER=                       # @jarvis:ton-domaine.fr (utile au chiffrement E2E)

# --- Drone (Parrot ANAFI) ---
# 0 = pas de drone ; sim = simulateur maison ; anafi = Parrot ANAFI ; mavlink = drone DIY (ArduPilot/PX4)
JARVIS_DRONE=0
JARVIS_DRONE_IP=192.168.42.1
# Drone DIY : adresse MAVLink. udp:127.0.0.1:14550 = simulateur ArduPilot SITL.
JARVIS_DRONE_URL=udp:127.0.0.1:14550
# Limites de vol. Sous la limite NORMALE (légale), le drone vole librement. Au-dessus
# (mais sous le PLAFOND absolu), Jarvis demande « vous êtes sûr ? » avant. Reste légal.
JARVIS_DRONE_ALT_MAX=120        # limite normale (légale), altitude en mètres
JARVIS_DRONE_ALT_PLAFOND=500    # plafond absolu, atteignable seulement en confirmant
JARVIS_DRONE_DIST_MAX=120       # limite normale, éloignement en mètres
JARVIS_DRONE_DIST_PLAFOND=2000  # plafond absolu d'éloignement (augmenté)
JARVIS_DRONE_PAS_MAX=20         # déplacement max par commande

# --- Vision (décrire une image : vue du drone, etc.) ---
# auto = local si dispo sinon Gemini ; local = modèle sur ce PC ; gemini ; 0 = coupée
JARVIS_VISION=auto
# Modèle de vision LOCAL via Ollama (privé, hors ligne). Ex. : ollama pull qwen2.5-vl
JARVIS_MODELE_VISION=

# --- Tableau de bord sur la télé (python dashboard.py) ---
# 127.0.0.1 = seulement sur ce PC (branché en HDMI). 0.0.0.0 = visible depuis le réseau (tablette).
JARVIS_ECRAN_HOTE=127.0.0.1
JARVIS_ECRAN_PORT=8765
# Jeton d'accès. VIVEMENT conseillé si JARVIS_ECRAN_HOTE=0.0.0.0, sinon tes rappels/listes/
# état maison sont lisibles par tout le monde sur le Wi-Fi. Ouvre alors la page avec /?jeton=...
JARVIS_ECRAN_JETON=

# --- Cerveau local (choisis selon ta machine) ---
# qwen3:30b-a3b (défaut) : MoE, malin ET rapide, idéal mini PC sans GPU.
# qwen3:32b : plus fin mais plus lent (écrit). mistral-small3.2 : léger et rapide.
# Le code difficile part de toute façon au renfort Claude/Gemini.
JARVIS_MODELE_LOCAL=qwen3:30b-a3b
# Modèle local SECONDAIRE, consultable comme un OUTIL (pas le cerveau), ex. dolphin-llama3.
# Jarvis le consulte via « demander_au_modele_local » : il répond, il n'agit pas. Ses
# réponses ne sont pas filtrées selon le modèle choisi. Vide = pas d'outil.
JARVIS_MODELE_SECONDAIRE=
# Mémoire associative : modèle d'embeddings Ollama LOCAL pour relier les souvenirs PAR LE SENS
# (ex. nomic-embed-text ; faire « ollama pull nomic-embed-text » d'abord). Vide = liens par
# mots partagés (local, sans dépendance, déjà actif). Outil : « relie ce que tu sais sur… ».
JARVIS_EMBEDDINGS=
# Qwen3 « réfléchit » avant de répondre : 0 = répond directement (plus rapide, conseillé à l'oral),
# 1 = réfléchit (meilleur pour les questions dures), vide = défaut du modèle.
JARVIS_REFLEXION_LOCALE=0
# Réglages fins trouvés par le banc d'essai (python bench.py --appliquer). Vide = automatique.
JARVIS_OPTIONS_OLLAMA=

# --- Initiatives : Jarvis parle en premier ---
# Heure du briefing du matin (météo, rappels du jour, courses, état du PC). Vide = pas de briefing.
JARVIS_BRIEFING=08:00
# Alertes sur le PC (disque presque plein, antivirus coupé, redémarrage conseillé). 0 = aucune.
JARVIS_ALERTES=1
# Sentinelle : surveille les signes d'intrusion et alerte (lecture seule). 0 = coupée.
JARVIS_SENTINELLE=1
# Cybersurveillance continue : en boucle, la machine (ports, réseau, pare-feu) ET le code
# de Jarvis lui-même (tripwire d'intégrité du cœur). Alerte si un fichier du cœur change
# hors du circuit validé. 0 = coupée. Intervalle en secondes.
JARVIS_CYBERSURVEILLANCE=1
JARVIS_CYBERSURVEILLANCE_SECONDES=300
# Réaction automatique : si un fichier du cœur est trafiqué, Jarvis le RESTAURE tout seul
# (sûr et réversible : il remet une version saine, il ne génère JAMAIS de code tout seul).
# 1 = activé. Si tu modifies le cœur hors du bot, fais « sauvegarde cœur » après.
JARVIS_AUTO_RESTAURATION=0
# CrowdSec (IDS/IPS réseau open-source) : il surveille et BLOQUE les intrusions réseau.
# Jarvis interroge sa LAPI locale (lecture seule) et t'annonce chaque IP nouvellement
# bloquée. 1 = activé. La clé bouncer est un SECRET (ne la mets jamais dans un commit) :
#   sudo cscli bouncers add jarvis   → copie la clé dans JARVIS_CROWDSEC_CLE.
JARVIS_CROWDSEC=0
JARVIS_CROWDSEC_URL=http://localhost:8080
JARVIS_CROWDSEC_CLE=
# Pot de miel (honeypot) : un faux serveur leurre. Toute connexion est suspecte -> Jarvis
# note l'IP et t'alerte. N'a aucun accès au cœur. 0 = coupé. Port > 1024.
JARVIS_HONEYPOT=0
JARVIS_HONEYPOT_PORT=2222
# Blocage d'IP défensif (commande « bloque <ip> » après une alerte). IP publiques à ne
# JAMAIS bloquer (ex. ton DNS), séparées par des virgules. Les IP privées sont déjà protégées.
JARVIS_IP_LISTE_BLANCHE=
# Heures de silence : ni briefing ni alerte (les rappels et les alertes de sécurité critiques passent toujours).
JARVIS_SILENCE=22:00-07:00

# --- Personnalité ---
# film = majordome flegmatique qui vous vouvoie ; ami = ton chaleureux, tutoiement
JARVIS_STYLE=film
# Comment Jarvis s'adresse à toi en style film (Monsieur, Madame, Patron...). Vide = ton prénom.
JARVIS_TITRE=
# Longueur des réponses : "normal" | "bref" | "militaire" (concis, une phrase, sans fioriture).
# C'est le levier direct si Jarvis est trop bavard (pas besoin de DSPy pour ça).
JARVIS_CONCISION=normal
# Voix : fr_FR-tom-medium.onnx (homme, défaut) ou fr_FR-siwis-medium.onnx (femme), chemin complet.
# Pour une voix encore plus nette, pointe vers un modèle « -high » (un peu plus lourd mais toujours rapide).
# JARVIS_VOIX_PIPER=
# Prosodie : rend la voix plus humaine, sans alourdir (reste instantané, local).
JARVIS_VOIX_VITESSE=1.06        # > 1 = plus posé, majordome ; 1.0 = normal
JARVIS_VOIX_PAUSES=0.35         # silence entre phrases (respiration), en secondes
JARVIS_VOIX_EXPRESSIVITE=0.7    # variation d'intonation : 0.3 = sobre, 1.0 = ample
# Mode mains libres : secondes d'écoute après une réponse, sans redire « Jarvis »
JARVIS_ECOUTE_SECONDES=30

# Reconnaissance de visages (locale). 1 = activée (nécessite face-recognition + pillow).
JARVIS_VISAGES=0

JARVIS_PRENOM=Enes
JARVIS_FUSEAU=Europe/Paris
# Ville par défaut pour la météo (seul le nom de la ville est envoyé à open-meteo.com)
JARVIS_VILLE=

# --- Annonces d'arrivée (caméras Frigate / Double Take, via MQTT) ---
# Jarvis annonce « Monsieur, Carlos est à la porte » et alerte sur un inconnu.
# Nécessite un broker MQTT (Mosquitto) et Frigate+Double Take. 0 = coupé.
# Installe : pip install paho-mqtt
JARVIS_MQTT=0
JARVIS_MQTT_HOTE=localhost
JARVIS_MQTT_PORT=1883
JARVIS_MQTT_SUJET=double-take/matches/#
JARVIS_MQTT_USER=
JARVIS_MQTT_PASS=
# Auto-regard : sur détection, Jarvis oriente une caméra motorisée vers la zone et décrit
# ce qu'il voit (nécessite des « presets » par zone dans ptz.json). 1 = activé, 0 = coupé.
JARVIS_AUTO_REGARD=1

# --- Mode détente (ambiance apaisante que TU déclenches) ---
# Pas de détection d'émotion (peu fiable, intrusive) : tu dis « mode détente » ou une
# routine « je rentre » le lance. Jarvis baisse les lumières et met une musique douce.
# L'outil n'apparaît que si des lumières OU un media_player sont renseignés ici.
JARVIS_DETENTE_LUMIERES=       # entity_id des lumières à tamiser, séparés par des virgules
JARVIS_DETENTE_NIVEAU=40       # luminosité par défaut en %
JARVIS_DETENTE_MEDIA=          # entity_id du media_player (ex. media_player.salon)
JARVIS_DETENTE_SOURCE=         # playlist/URL douce à jouer (facultatif)

# --- Habitudes : Jarvis anticipe mais PROPOSE (il n'agit pas en douce) ---
# Il lit l'historique Home Assistant (lecture seule) et repère tes routines par comptage
# explicable (« les mardis soirs de pluie, tu allumes le porche : 4/5 »). Outils : « mes
# habitudes », « anticiper maintenant ». 1 = activé.
JARVIS_HABITUDES=0
JARVIS_HABITUDES_ENTITES=      # entity_id à observer, séparés par des virgules (light.porche,climate.salon)
JARVIS_HABITUDES_METEO=        # entity_id weather.* pour le contexte météo (facultatif)
JARVIS_HABITUDES_JOURS=60      # fenêtre d'historique analysée (jours)
JARVIS_HABITUDES_SUPPORT=3     # nombre minimal d'occurrences pour retenir une habitude
JARVIS_HABITUDES_CONFIANCE=0.6 # fiabilité minimale (0 à 1)

# --- Suivi audio multi-room : le son te suit de pièce en pièce ---
# Snapcast diffuse un son synchronisé sur plusieurs enceintes ; Jarvis route le volume
# selon ta présence (capteurs mmWave / caméras Frigate exposés par Home Assistant).
# Outils vocaux : « suivez-moi », « arrête de suivre », « mets le son dans le salon ».
# 1 = suivi automatique dès le démarrage. L'« enceinte » est un media_player HA (défaut)
# ou un nom de client Snapcast (si JARVIS_SNAPSERVER est renseigné).
JARVIS_AUDIO_SUIVI=0
JARVIS_AUDIO_PIECES=           # JSON : {"cuisine":{"presence":"binary_sensor.cuisine_presence","enceinte":"media_player.snapcast_cuisine"},"salon":{"presence":"binary_sensor.salon_presence","enceinte":"media_player.snapcast_salon"}}
JARVIS_AUDIO_PRESENT=0.35      # volume (0 à 1) dans la pièce où tu es
JARVIS_AUDIO_ABSENT=0.0        # volume (0 à 1) dans une pièce vide
JARVIS_AUDIO_INTERVALLE=3      # fréquence de vérification de la présence (secondes)
JARVIS_SNAPSERVER=             # hôte du snapserver pour piloter Snapcast en direct (vide = via HA)
JARVIS_SNAPSERVER_PORT=1705

# --- Lunettes connectées : la caméra que tu portes interroge Jarvis ---
# Petit service HTTP local ; tes lunettes (OpenGlass / Brilliant Labs Monocle) postent
# l'image + la question, Jarvis répond en une phrase courte à afficher sur le verre.
#   POST http://maison:8766/voir?jeton=XXX&q=quelle+est+cette+piece  (corps = JPEG brut)
# Un jeton est EXIGÉ dès que l'hôte n'est pas local (127.0.0.1). La vision réutilise
# JARVIS_VISION (locale d'abord, Gemini en secours). 1 = activé.
JARVIS_LUNETTES=0
JARVIS_LUNETTES_HOTE=127.0.0.1 # 0.0.0.0 pour que les lunettes joignent via le Wi-Fi (jeton alors obligatoire)
JARVIS_LUNETTES_PORT=8766
JARVIS_LUNETTES_JETON=         # jeton d'accès (obligatoire si l'hôte n'est pas local)

# --- Authentification par empreinte vocale ---
# Les actions sensibles ne passent que si la VOIX est celle du propriétaire (ton enfant
# qui crie « ouvre le portail » → refusé). Échoue fermé (au doute, refus) ; un code
# maître sert de porte de secours si ta voix est mal reconnue. Empreintes 100 % locales.
# Nécessite SpeechBrain (pip install speechbrain) + un enrôlement : python enroll_voice.py
# C'est un FACTEUR de sécurité, pas un coffre-fort : garde un second verrou sur le vraiment critique.
JARVIS_VOIX_AUTH=0
JARVIS_VOIX_PROPRIO=proprietaire        # nom sous lequel tu t'enrôles
JARVIS_VOIX_SEUIL=0.65                  # similarité minimale (0 à 1) ; plus haut = plus strict
JARVIS_VOIX_ACTIONS=ouvrir,deverrouiller # outils protégés (ajoute le désarmement si tu veux)
JARVIS_VOIX_CODE=                        # code maître (porte de secours ; vide = pas de secours)
JARVIS_VOIX_FENETRE=60                  # durée (s) débloquée par le code maître

# --- Surveillance piscine — ALERTE de sécurité, PAS un détecteur de noyade ---
# ⚠️ Frigate détecte « une personne dans la zone piscine », PAS une noyade. Ceci NE
# REMPLACE JAMAIS une barrière, une couverture, une alarme de porte et ta surveillance.
# Sur détection : alarme + lumières + (option) déverrouillage des baies + alerte vocale,
# et si le mode Urgence est armé, alerte de tes contacts après un décompte annulable.
# Jarvis n'appelle PAS le 112 tout seul (faux positifs = fausses alertes aux secours) :
# il te hurle d'appeler et relaie au service que TU configures (ton téléphone, un gardien).
JARVIS_PISCINE=0
JARVIS_PISCINE_ZONES=                   # zones Frigate = « dans la piscine » (ex. bassin)
JARVIS_PISCINE_CAMERA=                  # caméra Frigate à surveiller (vide = toutes)
JARVIS_PISCINE_SIRENE=                  # entity_id de la sirène (ex. siren.piscine)
JARVIS_PISCINE_SIRENE_SERVICE=siren.turn_on
JARVIS_PISCINE_LUMIERES=                # lumières à allumer (entity_id, séparés par des virgules)
JARVIS_PISCINE_BAIES=                   # serrures des baies vitrées à déverrouiller (option)
JARVIS_PISCINE_HAUTPARLEUR=             # media_player pour l'annonce vocale
JARVIS_PISCINE_TTS=tts.google_translate_say
JARVIS_PISCINE_MESSAGE=                 # annonce (vide = message vrai par défaut)
JARVIS_PISCINE_URGENCE_DELAI=15         # décompte (s) avant d'alerter les contacts d'urgence
JARVIS_PISCINE_COOLDOWN=20              # délai (s) avant de re-déclencher l'alarme
JARVIS_PISCINE_WEBHOOK=                 # service d'alerte à TOI (téléphone/gardien) ; jamais le 112 en auto

# --- Vigilance thermique : la plaque de cuisson oubliée (MLX90640 via ESPHome) ---
# Une caméra thermique (~30 €) publie la température d'une zone ; si elle reste chaude
# alors que la maison est endormie (heures de silence) ou armée, Jarvis te prévient.
# Mesure de SURFACE, approximative : alerte seulement si chaud ET durable (anti-fausse alerte).
# Ne remplace pas un coupe-circuit ni ta vigilance. 1 = activé.
JARVIS_THERMIQUE=0
JARVIS_THERMIQUE_ZONES=                 # JSON : {"plaque gauche":{"capteur":"sensor.thermique_cuisine_max","seuil":70}}
JARVIS_THERMIQUE_DUREE=120              # secondes au-dessus du seuil avant d'alerter
JARVIS_THERMIQUE_INTERVALLE=30          # fréquence de vérification (secondes)
JARVIS_THERMIQUE_ARME=                  # input_boolean forçant la vigilance (ex. input_boolean.absent)

# --- Carte de présence : quelles pièces sont occupées (anonyme, chez toi) ---
# Source indifférente : PIR, radar mmWave, ou présence Wi-Fi (ESP32-CSI) publiée en
# binary_sensor. Occupation BINAIRE et ANONYME : pas d'identité, pas de respiration,
# pas de suivi de personne. Outils : « pièces occupées », « la maison est-elle vide ».
JARVIS_PRESENCE_PIECES=                 # JSON : {"salon":"binary_sensor.salon_presence","cuisine":"binary_sensor.cuisine_csi"}

# --- Simulation de présence « organique » (mode vacances) ---
# Quand TU armes le mode vacances (« arme le mode vacances »), Jarvis rejoue ta vie :
# lumières/prises/volets/media actifs selon le moment de la journée, avec une VARIATION
# aléatoire qui casse la régularité (pas de « 20h00 pile » tous les soirs). JAMAIS de
# serrure/portail dans une simulation (on ne déverrouille pas une maison vide). Opt-in :
# rien ne bouge tant que tu n'as pas armé. Outils : « arme/désarme/état mode vacances ».
JARVIS_SIMULATION=0
JARVIS_SIMULATION_ZONES=        # JSON : {"salon":{"entite":"light.salon","moments":["soir","nuit"]},"volet salon":{"entite":"cover.salon","moments":["matin","soir"]}}
JARVIS_SIMULATION_SECONDES=300  # fréquence d'un pas de simulation (secondes)

# --- Radio logicielle (RTL-SDR) : avions au-dessus (ADS-B) + météo radio locale ---
# Clé SDR (~25 €). Avions = donnée PUBLIQUE (dump1090) ; météo = TES capteurs (rtl_433).
# Pas de pistage TPMS des voitures, pas de ciblage d'un appareil d'autrui (voir radio.py).
JARVIS_ADSB=0
JARVIS_ADSB_URL=http://localhost:8080/data/aircraft.json
JARVIS_LAT=                             # latitude de la maison (ex. 48.85)
JARVIS_LON=                             # longitude de la maison (ex. 2.35)
JARVIS_ADSB_RAYON=15                    # rayon « au-dessus de nous » en km
JARVIS_METEO_RADIO=                     # JSON : {"temperature":"sensor.rtl_433_temp","humidite":"sensor.rtl_433_hum","pression":"sensor.rtl_433_press"}

# --- Battement de cœur : détecteur d'homme mort (résilience) ---
# Tant que Jarvis vit, il publie « online » sur un topic MQTT. Un veilleur INDÉPENDANT
# (binary_sensor MQTT avec expire_after côté Home Assistant, + une automation) bascule la
# maison en mode sûr si le battement s'arrête (serveur détruit/éteint). Voir heartbeat.py.
JARVIS_COEUR=0
JARVIS_COEUR_SUJET=jarvis/coeur
JARVIS_COEUR_SECONDES=30                # intervalle entre deux battements

# --- Audit de posture réseau : trouver les failles SANS les exploiter ---
# Scan NON destructif (nmap) de TON réseau : ports exposés, firmwares périmés, risques
# connus + conseils. Pas d'agent offensif, pas d'exploit, pas de pivot. Outil « audit réseau ».
# Isoler un appareil reste une action proposée, jamais menée seule. Nécessite nmap. 1 = activé.
JARVIS_AUDIT_RESEAU=0
JARVIS_AUDIT_CIBLE=192.168.1.0/24       # sous-réseau à auditer

# --- Freebox (API locale) : qui est sur le Wi-Fi, repérer les inconnus ---
# Appaire une fois : « python appairer_freebox.py » (valide sur l'écran de la Freebox),
# puis colle le jeton dans JARVIS_FREEBOX_JETON. Tout reste local. Outil « appareils wifi ».
JARVIS_FREEBOX_URL=http://mafreebox.freebox.fr
JARVIS_FREEBOX_JETON=                    # jeton d'appairage (secret), donné par appairer_freebox.py
JARVIS_FREEBOX_CONNUS=                   # tes appareils connus (noms ou MAC), séparés par des virgules

# --- Surveillance auth Wi-Fi 802.1X (FreeRADIUS) ---
# Jarvis ne lance pas FreeRADIUS (démon) ; il LIT son journal et signale les tentatives
# d'authentification rejetées (appareil inconnu, certif révoqué, Evil Twin repoussé).
# Lecture seule. Nécessite des points d'accès « Enterprise » + FreeRADIUS. 1 = activé.
JARVIS_RADIUS=0
JARVIS_RADIUS_LOG=/var/log/freeradius/radius.log

# --- Détection d'instabilité Wi-Fi (symptôme d'une attaque de déauth) ---
# Le PMF (802.11w) sur ton AP EMPÊCHE la déauth ; Jarvis en détecte le SYMPTÔME via la
# liste Freebox (appareils qui se déconnectent en rafale). Nécessite la Freebox appairée.
# Une instabilité peut aussi venir d'un signal faible : Jarvis signale, ne conclut pas. 1 = activé.
JARVIS_WIFI_STABILITE=0
JARVIS_WIFI_STABILITE_SEUIL=4            # déconnexions d'un même appareil avant d'alerter
JARVIS_WIFI_STABILITE_FENETRE=120       # fenêtre de comptage (secondes)
JARVIS_WIFI_STABILITE_SECONDES=20       # fréquence de vérification

# --- Surveillance Starlink : l'Internet de la maison (WAN) ---
# Jarvis lit l'antenne Starlink en local (gRPC, 192.168.100.1) et alerte sur une
# coupure, une obstruction (arbres/neige) ou une alerte matériel. Outil « état internet ».
# Nécessite : pip install starlink-grpc-tools. 1 = activé.
JARVIS_STARLINK=0
JARVIS_STARLINK_SECONDES=60             # fréquence de vérification de la liaison

# --- Bastion OPNsense : fil d'alarme sur la segmentation VLAN (cœur vs IoT) ---
# OPNsense sépare le réseau ; Jarvis lit son journal et alerte si un appareil IoT tente
# d'atteindre le cœur (objet compromis). Clé/secret API = SECRETS. Outil « point pare-feu ».
# Crée une clé API dans OPNsense (System > Access > Users). 1 = activé.
JARVIS_OPNSENSE=0
JARVIS_OPNSENSE_URL=https://opnsense.local
JARVIS_OPNSENSE_CLE=                     # clé API OPNsense
JARVIS_OPNSENSE_SECRET=                  # secret API OPNsense (secret !)
JARVIS_OPNSENSE_COEUR=10.0.1.0/24        # sous-réseau(x) du VLAN cœur, séparés par des virgules
JARVIS_OPNSENSE_IOT=10.0.9.0/24          # sous-réseau(x) du VLAN IoT
JARVIS_OPNSENSE_SECONDES=60              # fréquence de lecture du journal

# --- Kill-switch visuel tondeuse (Frigate -> MQTT) : MARGE de sécurité, pas le gardien ---
# Frigate voit une personne/animal dans la zone de tonte -> Jarvis coupe les lames (MQTT).
# Arrêt autonome ; reprise PRUDENTE (périmètre dégagé depuis REPRISE_DELAI, ou manuelle).
# NE REMPLACE PAS les sécurités propres de la tondeuse ni ta surveillance. 1 = activé.
JARVIS_TONDEUSE=0
JARVIS_TONDEUSE_ZONES=                   # zones Frigate de la pelouse (ex. pelouse)
JARVIS_TONDEUSE_CAMERA=                  # caméra Frigate à surveiller (vide = toutes)
JARVIS_TONDEUSE_LABELS=person,dog,cat    # objets qui déclenchent l'arrêt
# Backend : "mqtt" (topic brut) ou "ha" (entité lawn_mower de Home Assistant — Husqvarna, Worx).
# "ha" recommandé : l'arrêt = pause HA (lames coupées sur place). Le cloud HA reste toutefois
# trop lent pour un vrai arrêt d'urgence : ce kill-switch est une marge, la sécurité temps réel
# doit venir de la tondeuse elle-même (évitement visuel embarqué : Ecovacs Goat, Navimow…).
JARVIS_TONDEUSE_BACKEND=mqtt
JARVIS_TONDEUSE_ENTITE=                   # entité lawn_mower si backend=ha (ex. lawn_mower.jardin)
JARVIS_TONDEUSE_BATTERIE=                 # capteur batterie (facultatif, ex. sensor.automower_battery)
JARVIS_TONDEUSE_TOPIC=mower/command      # topic MQTT de commande (si backend=mqtt)
JARVIS_TONDEUSE_STOP=stop                # charge MQTT pour arrêter (selon ta tondeuse)
JARVIS_TONDEUSE_START=start              # charge MQTT pour reprendre
JARVIS_TONDEUSE_REPRISE_AUTO=1           # 1 = reprise auto après dégagement ; 0 = reprise manuelle
JARVIS_TONDEUSE_REPRISE_DELAI=60         # secondes de périmètre dégagé avant de reprendre

# --- Mode Sentinelle (réaction active anti-intrusion) ---
# Tu l'armes (« Jarvis, arme la surveillance ») ; sur visage INCONNU, Jarvis allume les
# lumières, (option) verrouille, enregistre, diffuse une sommation et t'alerte.
# Jarvis n'appelle JAMAIS la police seul : il t'alerte, tu décides.
JARVIS_SURV_LUMIERES=          # entity_id des lumières extérieures, séparés par des virgules
JARVIS_SURV_SERRURES=          # entity_id des serrures
JARVIS_SURV_VERROUILLER=0      # 1 = verrouiller les portes sur intrusion
JARVIS_SURV_HAUTPARLEUR=       # media_player extérieur pour la sommation
JARVIS_SURV_MESSAGE=           # vide = « zone sous surveillance, vous êtes enregistré »
JARVIS_SURV_TTS=tts.google_translate_say
JARVIS_SURV_ENR_SERVICE=       # service HA pour lancer un enregistrement (ex. switch.turn_on)
JARVIS_SURV_ENR_ENTITE=

# --- Point de situation (lecture seule) ---
# Capteurs que Jarvis surveille pour avoir conscience du moment (détections caméra, état du
# drone, batteries...). « Jarvis, fais le point. » entity_id séparés par des virgules.
JARVIS_TELEMETRIE=

# --- Arroseur anti-nuisibles (dissuasion par zone, pas de ciblage) ---
# Associe une zone du jardin à l'interrupteur de son arroseur. « Jarvis, arrose le parterre. »
# Pour un déclenchement auto sur détection d'animal, crée une automatisation HA (capteur -> arroseur).
# JARVIS_ARROSEUR={"parterre":"switch.arroseur_parterre","potager":"switch.arroseur_potager"}

# --- Ouïe analytique (classification des sons, YAMNet) ---
# Un micro + YAMNet : Jarvis entend bris de glace, alarme incendie, pleurs, cri...
# et t'alerte (+ reaction Sentinelle si armee). Lourd a installer : pip install tensorflow tensorflow-hub
JARVIS_OREILLE=0
JARVIS_OREILLE_SEUIL=0.5

# --- Detection d'objets personnalisee (Ultralytics YOLO) ---
# Entraine YOLO sur tes objets (colis, porte de garage ouverte, outil manquant...) et donne
# ici le chemin du modele .pt. « Y a-t-il un colis a l'entree ? ». Vide = desactive.
# pip install ultralytics
JARVIS_YOLO_MODELE=
JARVIS_YOLO_SEUIL=0.4

# --- Robot mobile (ROS 2 / Nav2) ---
# Destinations autorisees ou tu peux envoyer le robot (« va au garage »). Jarvis envoie
# l'ordre par MQTT ; un petit noeud ROS sur le robot fait la navigation (SLAM/Nav2).
# Le robot, ROS 2 et la navigation sont a construire cote materiel : c'est un gros projet.
# JARVIS_ROBOT_LIEUX=garage,salon,cuisine,bureau
