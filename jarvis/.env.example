# Copie ce fichier en .env puis remplis-le.  (cp .env.example .env)

# --- Renfort Claude pour les questions difficiles ---
#   abonnement : passe par Claude Code connecté à ton compte Claude (pas de coût en plus)
#   api        : passe par une clé API Anthropic (payé à l'usage)
#   aucun      : 100 % local
JARVIS_RENFORT=abonnement

# Mode "abonnement" : modèle Claude Code (vide = celui par défaut de ton compte, ex. opus, sonnet)
JARVIS_MODELE_ABONNEMENT=

# Mode "api" uniquement : clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=
JARVIS_MODELE_CLAUDE=claude-opus-5-5
JARVIS_EFFORT_CLAUDE=medium

# --- Confidentialité ---
# 1 = rien ne sort de l'ordinateur (renfort Claude coupé, Hugging Face bloqué).
# À activer seulement une fois l'installation terminée (Whisper doit être téléchargé).
JARVIS_HORS_LIGNE=0

# --- Bot Telegram (python telegram_bot.py) ---
# Jeton donné par @BotFather sur Telegram. Ne le partage jamais.
TELEGRAM_TOKEN=
# Ton identifiant Telegram : le bot ne répond qu'à lui.
# Laisse vide au début : envoie /start au bot, il te donnera le numéro à mettre ici.
JARVIS_TELEGRAM_ID=

# --- Cerveau local (voir le README pour choisir selon la RAM du Mac) ---
JARVIS_MODELE_LOCAL=mistral-small3.2
# Qwen3 « réfléchit » avant de répondre : 0 = répond directement (plus rapide, conseillé à l'oral)
JARVIS_REFLEXION_LOCALE=
# Réglages fins trouvés par le banc d'essai (python bench.py --appliquer). Vide = automatique.
JARVIS_OPTIONS_OLLAMA=

JARVIS_PRENOM=Enes
JARVIS_FUSEAU=Europe/Paris
# Ville par défaut pour la météo (seul le nom de la ville est envoyé à open-meteo.com)
JARVIS_VILLE=
