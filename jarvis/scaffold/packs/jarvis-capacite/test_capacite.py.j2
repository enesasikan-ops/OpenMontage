def test_every_tool_answers_a_sentence():
    for tool in capacite.build_tools():
        props = tool.parameters["properties"]
        args = {name: EXEMPLES[spec["type"]] for name, spec in props.items()}
        assert isinstance(tool.run(**args), str)


