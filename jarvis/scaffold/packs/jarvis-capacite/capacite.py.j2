def build_tools() -> list:
    """Appelée par Jarvis au démarrage pour charger la capacité."""
    return [
{% for a in actions %}
        Tool(
            name={{ a.nom | pyrepr }},
            description={{ a.description | pyrepr }},
            parameters={
                "type": "object",
                "properties": {
{% for p in a.parametres %}
                    {{ p.nom | pyrepr }}: {"type": {{ p.type | pyrepr }}, "description": {{ p.description | pyrepr }}},
{% endfor %}
                },
                "required": [{% for p in a.parametres if p.requis %}{{ p.nom | pyrepr }}{% if not loop.last %}, {% endif %}{% endfor %}],
            },
            run={{ a.nom }},
{% if a.sensible %}
            confirm=lambda **_: {{ (a.confirmation or ("Je vais exécuter " ~ a.nom ~ ".")) | pyrepr }},
{% endif %}
        ),
{% endfor %}
    ]
