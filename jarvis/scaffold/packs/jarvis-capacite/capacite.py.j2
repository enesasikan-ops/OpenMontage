{% for a in actions %}


def {{ a.nom }}({% for p in a.parametres %}{{ p.nom }}{% if not p.requis %}=None{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}) -> str:
    """{{ a.description }}"""
